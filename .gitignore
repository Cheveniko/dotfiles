.DS_Store

# Private, machine-specific configuration must never enter this public repo.
.env
.env.*
.zshrc.local
.wezterm.local.lua
.npmrc
.pgpass
.netrc
.git-credentials
**/db_ui/
**/.ssh/
**/backups/
*.pem
*.key

__pycache__/
*.pyc

# Only reviewed, public AI configuration belongs in these packages.
/opencode/.config/opencode/*
!/opencode/.config/opencode/opencode.json
!/opencode/.config/opencode/cli.json
!/opencode/.config/opencode/AGENTS.md
/claude/.claude/*
